{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@chief-strategist-j/shared-infra": [
        "../shared-infra/dist/index.d.ts"
      ],
      "@chief-strategist-j/shared-infra/http": [
        "../shared-infra/dist/http/http-client.d.ts"
      ],
      "@chief-strategist-j/shared-infra/discovery": [
        "../shared-infra/dist/discovery/index.d.ts"
      ],
      "@chief-strategist-j/shared-infra/feature-flags": [
        "../shared-infra/dist/feature-flags/resolve-flag.d.ts"
      ],
      "@chief-strategist-j/shared-infra/rules-engine": [
        "../shared-infra/dist/rules-engine/index.d.ts"
      ],
      "@chief-strategist-j/shared-infra/json-map": [
        "../shared-infra/dist/json-map/index.d.ts"
      ],
      "@chief-strategist-j/shared-infra/*": [
        "../shared-infra/dist/*"
      ],
      "@observability/auth": [
        "../auth/src/index.ts"
      ],
      "@observability/auth/*": [
        "../auth/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
